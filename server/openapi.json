{
  "openapi": "3.1.0",
  "info": {
    "title": "Hearthrise API",
    "version": "0.7.0"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "AuthGoogleRequest": {
        "type": "object",
        "required": [
          "idToken"
        ],
        "properties": {
          "idToken": {
            "type": "string",
            "minLength": 1,
            "description": "A Google ID token for the Web client id."
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "token",
          "expiresAt",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Opaque bearer token; only its hash is stored."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "ChangeDto": {
        "type": "object",
        "required": [
          "table",
          "id",
          "op"
        ],
        "properties": {
          "table": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "upsert",
              "delete"
            ]
          },
          "updatedAt": {
            "type": "string",
            "description": "Required on an upsert of a mutable table."
          },
          "deletedAt": {
            "type": "string"
          },
          "row": {
            "type": "object",
            "description": "Payload columns in snake_case, as in the app database. Absent on a delete.",
            "additionalProperties": {}
          }
        }
      },
      "PushRequest": {
        "type": "object",
        "required": [
          "deviceId",
          "changes"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeDto"
            },
            "maxItems": 1000
          }
        }
      },
      "PushResult": {
        "type": "object",
        "required": [
          "table",
          "id",
          "status"
        ],
        "properties": {
          "table": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "ignored",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "clock",
              "malformed"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PushResponse": {
        "type": "object",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PushResult"
            }
          }
        }
      },
      "PulledChangeDto": {
        "type": "object",
        "required": [
          "table",
          "id",
          "op",
          "seq",
          "deviceId"
        ],
        "properties": {
          "table": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "upsert",
              "delete"
            ]
          },
          "seq": {
            "type": "integer"
          },
          "deviceId": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "deletedAt": {
            "type": "string"
          },
          "row": {
            "type": "object",
            "description": "Payload columns in snake_case, as in the app database. Absent on a delete.",
            "additionalProperties": {}
          }
        }
      },
      "PullResponse": {
        "type": "object",
        "required": [
          "changes",
          "cursor",
          "hasMore"
        ],
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PulledChangeDto"
            }
          },
          "cursor": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/google": {
      "post": {
        "operationId": "authGoogle",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthGoogleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sync/push": {
      "post": {
        "operationId": "syncPush",
        "tags": [
          "sync"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushRequest"
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushResponse"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sync/pull": {
      "get": {
        "operationId": "syncPull",
        "tags": [
          "sync"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "in": "query",
            "name": "since",
            "required": true
          }
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullResponse"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
