  "fixed_sql": [
    {
      "name": "bosses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bosses\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"defeat_meaning\" TEXT NULL, \"status\" INTEGER NOT NULL, \"attempt_number\" INTEGER NOT NULL DEFAULT 1, \"reset_on_fail\" INTEGER NOT NULL, \"is_pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pinned\" IN (0, 1)), \"target_date\" TEXT NULL, \"last_fought_at\" TEXT NULL, \"open_from_attempt\" INTEGER NOT NULL DEFAULT 1, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"defeated_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "phases",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"phases\" (\"id\" TEXT NOT NULL, \"boss_id\" TEXT NOT NULL REFERENCES bosses (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"open_from_attempt\" INTEGER NOT NULL DEFAULT 1, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"boss_id\" TEXT NOT NULL REFERENCES bosses (id) ON DELETE CASCADE, \"phase_id\" TEXT NULL REFERENCES phases (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"weight\" INTEGER NOT NULL, \"recurrence\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"is_split\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_split\" IN (0, 1)), \"daily_deadline_minutes\" INTEGER NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attempts\" (\"id\" TEXT NOT NULL, \"boss_id\" TEXT NOT NULL REFERENCES bosses (id) ON DELETE CASCADE, \"task_id\" TEXT NULL REFERENCES tasks (id) ON DELETE SET NULL, \"boss_attempt\" INTEGER NOT NULL, \"outcome\" INTEGER NOT NULL, \"cause\" INTEGER NULL, \"phase_id\" TEXT NULL REFERENCES phases (id) ON DELETE SET NULL, \"lesson\" TEXT NULL, \"weight\" INTEGER NULL, \"day\" TEXT NOT NULL, \"at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"tap_mode\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tap_mode\" IN (0, 1)), \"default_reset_on_fail\" INTEGER NOT NULL DEFAULT 0, \"haptics\" INTEGER NOT NULL DEFAULT 1 CHECK (\"haptics\" IN (0, 1)), \"rollover_hour\" INTEGER NOT NULL DEFAULT 4, \"reminder_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reminder_enabled\" IN (0, 1)), \"reminder_minutes\" INTEGER NOT NULL DEFAULT 1260, \"flasks\" INTEGER NOT NULL DEFAULT 3, \"last_resolved_day\" TEXT NULL, \"first_day\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "day_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"day_logs\" (\"day\" TEXT NOT NULL, \"kind\" INTEGER NOT NULL, \"lesson\" TEXT NULL, \"at\" TEXT NOT NULL, PRIMARY KEY (\"day\", \"kind\"));"
        }
      ]
    },
    {
      "name": "ember_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ember_events\" (\"id\" TEXT NOT NULL, \"kind\" INTEGER NOT NULL, \"amount\" INTEGER NOT NULL, \"boss_id\" TEXT NULL REFERENCES bosses (id) ON DELETE SET NULL, \"task_id\" TEXT NULL REFERENCES tasks (id) ON DELETE SET NULL, \"day\" TEXT NOT NULL, \"at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "plan_picks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plan_picks\" (\"day\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"day\", \"task_id\"));"
        }
      ]
    },
    {
      "name": "commitments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"commitments\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"boss_id\" TEXT NOT NULL REFERENCES bosses (id) ON DELETE CASCADE, \"day\" TEXT NOT NULL, \"deadline\" TEXT NOT NULL, \"extensions\" INTEGER NOT NULL DEFAULT 0, \"remind\" INTEGER NOT NULL DEFAULT 0 CHECK (\"remind\" IN (0, 1)), \"outcome\" INTEGER NULL, \"resolved_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"task_id\", \"day\"));"
        }
      ]
    },
