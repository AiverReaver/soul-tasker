  "fixed_sql": [
    {
      "name": "bosses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bosses\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"defeat_meaning\" TEXT NULL, \"status\" INTEGER NOT NULL, \"attempt_number\" INTEGER NOT NULL DEFAULT 1, \"reset_on_fail\" INTEGER NOT NULL, \"is_pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pinned\" IN (0, 1)), \"target_date\" TEXT NULL, \"last_fought_at\" TEXT NULL, \"open_from_attempt\" INTEGER NOT NULL DEFAULT 1, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"defeated_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "phases",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"phases\" (\"id\" TEXT NOT NULL, \"boss_id\" TEXT NOT NULL REFERENCES bosses (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"open_from_attempt\" INTEGER NOT NULL DEFAULT 1, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"boss_id\" TEXT NOT NULL REFERENCES bosses (id) ON DELETE CASCADE, \"phase_id\" TEXT NULL REFERENCES phases (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"weight\" INTEGER NOT NULL, \"recurrence\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"is_split\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_split\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attempts\" (\"id\" TEXT NOT NULL, \"boss_id\" TEXT NOT NULL REFERENCES bosses (id) ON DELETE CASCADE, \"task_id\" TEXT NULL REFERENCES tasks (id) ON DELETE SET NULL, \"boss_attempt\" INTEGER NOT NULL, \"outcome\" INTEGER NOT NULL, \"cause\" INTEGER NULL, \"phase_id\" TEXT NULL REFERENCES phases (id) ON DELETE SET NULL, \"lesson\" TEXT NULL, \"day\" TEXT NOT NULL, \"at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"tap_mode\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tap_mode\" IN (0, 1)), \"default_reset_on_fail\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
